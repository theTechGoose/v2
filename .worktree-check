#!/bin/sh
# .worktree-check — the repo's merge gate, run by `worktree-merge` (REQ-042).
#
# Without this file the tool auto-detects `deno test -A` at the git root, which
# (a) type-checks jest/**/*.test.ts — a Node/Jest harness outside the Deno
# workspace — and aborts on 2,340 "Cannot find name 'expect'" errors before a
# single test runs, and (b) would run the backend's Deno KV tests without
# `--unstable-kv`. So the gate is declared here: the three suites that need no
# live server, exactly as each project runs them.
#
# Not here on purpose (they need `deno task serve` on :5280/:4280 and a
# browser): `cd jest && npm run test:integration` and the Cypress specs. Those
# are the test-drive, reported to the merge via `--tested`.
set -eu
cd "$(dirname "$0")"

echo "== gate 1/3: backend  (cd backend && deno task test)"
( cd backend && deno task test )

echo "== gate 2/3: front-end type-check  (cd front-end && deno check)"
( cd front-end && deno check )

echo "== gate 3/3: jest unit  (cd jest && npm run test:unit)"
( cd jest && npm run test:unit -- --ci )

echo "== gate: all green"
