# OpenAI API key — required in production for job options, pricing, polish, and voice-memo transcription.
OPENAI_API_KEY=
# Must be exactly "openai" in production; anything else binds the echo stub (boot now refuses that on Deno Deploy). REQ-001
AGENTS_LLM_CLIENT=openai
# Must be exactly "openai" in production; same rule as AGENTS_LLM_CLIENT.
TRANSCRIPTION_CLIENT=openai
# Optional model override for the LLM calls (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Public origin of the app, used in outbound links (e.g. https://app.paperworkmonster.com).
APP_URL=

# REQ-054 — the CRM's link builder (ppwk-crm payments) behind a paid plan: origin + operator token.
# REQ-069 — and the name of the CRM merchant account every charge goes through (its Accounts tab;
# the `x-account` header of every mint and subscription). All three unset = the in-process fake
# (what the gate's lanes and a dev box run on); in production all three are required.
PPWK_PAYMENTS_URL=
PPWK_PAYMENTS_TOKEN=
PPWK_PAYMENTS_ACCOUNT=
