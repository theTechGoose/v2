# OpenAI API key — required in production for job options, pricing, polish, and voice-memo transcription.
OPENAI_API_KEY=
# Must be exactly "openai" in production; anything else binds the echo stub (boot now refuses that on Deno Deploy). REQ-001
AGENTS_LLM_CLIENT=openai
# Must be exactly "openai" in production; same rule as AGENTS_LLM_CLIENT.
TRANSCRIPTION_CLIENT=openai
# Optional model override for the LLM calls (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Public origin of the app, used in outbound links (e.g. https://documonster.com).
APP_URL=

# REQ-054 — the CRM's link builder (ppwk-crm payments) behind a paid plan: origin + operator token.
# REQ-069 — and the name of the CRM merchant account every charge goes through (its Accounts tab;
# the `x-account` header of every mint and subscription). All three unset = the in-process fake
# (what the gate's lanes and a dev box run on); in production all three are required.
PPWK_PAYMENTS_URL=
PPWK_PAYMENTS_TOKEN=
PPWK_PAYMENTS_ACCOUNT=

# REQ-080 — the Meta Pixel (Facebook ads conversion tracking) on the ad funnel's pages: the
# dataset's id from Events Manager. Read only on the real deploy; unset there = no pixel at all.
# A dev box and the gate never load Meta's script (DENO_DEPLOY unset = the fake loader).
META_PIXEL_ID=
# REQ-183: the Google Tag Manager container (GTM-…). Unset = no GTM on the real deploy.
GTM_ID=

# communications (REQ-899..901) — the business's own line on a SEPARATE Twilio account.
# Leave COMMS_TWILIO_ACCOUNT_SID unset for dev mode (texts are logged, not sent).
COMMS_TWILIO_ACCOUNT_SID=
COMMS_TWILIO_AUTH_TOKEN=
COMMS_TWILIO_FROM=                 # the line, E.164, e.g. +18435550100
COMMS_TWILIO_API_KEY_SID=          # Standard API key (SK…) for the softphone token
COMMS_TWILIO_API_KEY_SECRET=
COMMS_TWILIO_TWIML_APP_SID=        # TwiML App (AP…) whose Voice URL is $COMMS_PUBLIC_URL/communications/twilio/voice/outgoing
COMMS_PUBLIC_URL=                  # https origin Twilio reaches us at; webhooks and the relay wss url are built on it
COMMS_FALLBACK=agent               # agent | voicemail | forward | hangup — what happens when no softphone answers
COMMS_FORWARD_TO=                  # E.164, only for COMMS_FALLBACK=forward
COMMS_RING_IDENTITIES=             # comma-separated softphone identities to ring (a user's id with dashes → underscores)
COMMS_RING_TIMEOUT_SEC=20
COMMS_AGENT_GREETING=              # what the AI receptionist says first (optional)
COMMS_AGENT_PROMPT=                # its system prompt (optional; see domain/data/config for the default)
# REQ-904 — the user id that owns the env line above (their inbox, softphone and texts use it).
# Every other user buys their own number (POST /communications/numbers) on a Twilio subaccount.
COMMS_ENV_LINE_OWNER=
