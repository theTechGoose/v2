[TYP:uuid] id: string
    a unique record identifier
[TYP:ext] userId: string
    the authenticated owner id, minted from the session
[TYP] createdAt: string
    an ISO creation timestamp
[TYP] updatedAt: string
    an ISO last-updated timestamp
[TYP] ok: boolean
    a success flag
[TYP] customerId: string
    a reference to a CRM customer
[TYP] summary: string
    the quote summary line
[TYP] jobName: string
    a short job title
[TYP] description: string
    freeform description text
[TYP] descriptionByLang: string
    a JSON map of description keyed by language code
[TYP] jobNameByLang: string
    a JSON map of job title keyed by language code
[TYP] summaryByLang: string
    a JSON map of summary keyed by language code
[TYP] estimatedTotal: number
    total quote value in integer cents
[TYP] status: string
    lifecycle status: draft, sent, viewed, accepted (canonical; never approved), or lost
[TYP] sentAt: string
    ISO timestamp the document was sent
[TYP] acceptedAt: string
    ISO timestamp the quote was accepted
[TYP] lostAt: string
    ISO timestamp the quote was declined
[TYP] acceptedSignature: string
    captured acceptance signature data
[TYP] acceptedName: string
    name of who accepted the quote
[TYP] acceptedTinMasked: string
    masked TIN captured at the signature ceremony, last 4 only
[TYP] acceptedNotifiedAt: string
    idempotency stamp: the post-accept billing and confirmation already ran
[TYP] declineReason: string
    machine-readable decline reason chip
[TYP] declineNote: string
    freetext note left by the declining customer
[TYP] declinedName: string
    name of who declined the quote
[TYP] stepId: string
    terms-wizard step identifier
[TYP] label: string
    a human-readable label
[TYP] value: string
    a resolved agreed value
[TYP] effectiveDate: string
    agreement effective date
[TYP] startDate: string
    agreement start date
[TYP] estimatedCompletionDate: string
    estimated completion date
[TYP] term: QuoteTermDto
    a nested captured agreement term
[TYP] quantity: number
    a line-item quantity
[TYP] unit: string
    a line-item unit label
[TYP] price: number
    per-unit price in integer cents
[TYP] to: string
    the dispatch recipient address
[TYP] from: string
    the dispatch sender address
[TYP] reason: string
    a machine-readable reason code
[TYP] subject: string
    the email subject line
[TYP] sid: string
    a Twilio message SID
[TYP] kind: string
    a resource kind discriminator
[TYP] code: string
    a shortlink code
[TYP] paperworkType: string
    paperwork kind: quote or invoice
[TYP] paperworkId: string
    id of the viewed paperwork record
[TYP] viewedAt: string
    ISO timestamp of the view
[TYP] viewerId: string
    identifier of the viewer
[TYP] viewerEmail: string
    email of the viewer
[TYP] userAgent: string
    raw user-agent of the viewer
[TYP] ipAddress: string
    viewer ip address
[TYP] referrer: string
    referrer url of the view
[TYP:int] durationMs: number
    view duration in milliseconds
[TYP] total: number
    a total amount or count
[TYP:int] uniqueViewers: number
    count of distinct viewers
[TYP] firstViewedAt: string
    ISO timestamp of the first view
[TYP] lastViewedAt: string
    ISO timestamp of the most recent view
[TYP] lineItem: LineItemDto
    a nested quote line item
[TYP] view: ViewDto
    a nested view record
[TYP] stats: ViewStatsDto
    nested view statistics

[DTO] LineItemDto: description, quantity, unit, price
    a single quote line item
[DTO] QuoteTermDto: stepId, label, value
    a captured terms-wizard answer, stored in English on the quote
[DTO] CreateQuoteDto: customerId?, summary, jobName?, description?, descriptionByLang?, jobNameByLang?, summaryByLang?, lineItem(s), estimatedTotal?, status?, term(s), effectiveDate?, startDate?, estimatedCompletionDate?, sentAt?, acceptedAt?, lostAt?, acceptedSignature?, acceptedName?, acceptedTinMasked?, acceptedNotifiedAt?, declineReason?, declineNote?, declinedName?
    input to create a quote
[DTO] UpdateQuoteDto: customerId?, summary?, jobName?, description?, descriptionByLang?, jobNameByLang?, summaryByLang?, lineItem(s), estimatedTotal?, status?, term(s), effectiveDate?, startDate?, estimatedCompletionDate?, sentAt?, acceptedAt?, lostAt?, acceptedSignature?, acceptedName?, acceptedTinMasked?, acceptedNotifiedAt?, declineReason?, declineNote?, declinedName?
    a partial quote patch
[DTO] QuoteDto: id, userId, customerId?, summary, jobName?, description?, descriptionByLang?, jobNameByLang?, summaryByLang?, lineItem(s), estimatedTotal?, status?, term(s), effectiveDate?, startDate?, estimatedCompletionDate?, sentAt?, acceptedAt?, lostAt?, acceptedSignature?, acceptedName?, acceptedTinMasked?, acceptedNotifiedAt?, declineReason?, declineNote?, declinedName?, createdAt, updatedAt
    the persisted Quote + Agreement document record
[DTO] CreateViewDto: paperworkType, paperworkId, viewedAt, viewerId?, viewerEmail?, userAgent?, ipAddress?, referrer?, durationMs?
    input to record a paperwork view
[DTO] UpdateViewDto: paperworkType?, paperworkId?, viewedAt?, viewerId?, viewerEmail?, userAgent?, ipAddress?, referrer?, durationMs?
    a partial view patch
[DTO] ViewDto: id, paperworkType, paperworkId, viewedAt, viewerId?, viewerEmail?, userAgent?, ipAddress?, referrer?, durationMs?, createdAt, updatedAt
    a persisted view record
[DTO] ViewListDto: view(s)
    a list of views
[DTO] ViewQueryDto: paperworkType?, paperworkId?
    optional filters for listing views
[DTO] ViewSummaryRefDto: paperworkType, paperworkId
    a reference to summarize views for a record
[DTO] ViewStatsDto: total, uniqueViewers, firstViewedAt?, lastViewedAt?
    aggregated view statistics
[DTO] PaperworkViewSummaryDto: paperworkType, paperworkId, view(s), stats
    views plus computed stats for a record
[DTO] EmailDispatchDto: id, to?, from?
    input to email a paperwork resource
[DTO] SmsDispatchDto: id, to?
    input to text a paperwork resource
[DTO] EmailMessageDto: to, subject
    an outbound email envelope
[DTO] SmsMessageDto: to
    an outbound SMS envelope
[DTO] SendEmailResultDto: ok, reason?, to, subject
    result of an email dispatch
[DTO] SendSmsResultDto: ok, to, sid?, reason?
    result of an SMS dispatch
[DTO] ShortlinkMintDto: userId, kind, id
    input to mint or reuse a shortlink
[DTO] ShortlinkDto: code, kind, id
    a persisted shortlink record
[DTO] OwnerDto: userId
    the owning user id wrapper
[DTO] GetByIdDto: id
    an id lookup wrapper
[DTO] OkDto: ok
    a success body for deletes

[NON] quote
    a single quote — the merged Quote + Agreement document (no separate agreement entity)
[NON] view
    a single paperwork view
[NON] shortlink
    a shortlink store
[NON] email
    the outbound email service
