[TYP:uuid] id: string
    a unique record identifier
[TYP:ext] userId: string
    the authenticated owner id, minted from the session
[TYP] createdAt: string
    an ISO creation timestamp
[TYP] updatedAt: string
    an ISO last-updated timestamp
[TYP:nonempty] name: string
    a display or person name
[TYP:email] email: string
    a contact email address
[TYP] phoneNumber: string
    a contact phone number
[TYP] ok: boolean
    a success flag
[TYP] status: string
    a lifecycle status string
[TYP] reason: string
    a machine-readable reason code
[TYP] customerId: string
    a reference to a CRM customer
[TYP] contractId: string
    a reference to a contract
[TYP] quoteId: string
    a reference to a quote
[TYP] invoiceId: string
    a reference to an invoice
[TYP] summary: string
    the quote summary line
[TYP] jobName: string
    a short job title
[TYP] description: string
    freeform description text
[TYP] descriptionByLang: string
    a JSON map of description keyed by language code
[TYP] jobNameByLang: string
    a JSON map of job title keyed by language code
[TYP] summaryByLang: string
    a JSON map of summary keyed by language code
[TYP] estimatedTotal: number
    total quote value in integer cents
[TYP] sentAt: string
    ISO timestamp the document was sent
[TYP] acceptedAt: string
    ISO timestamp the quote was accepted
[TYP] lostAt: string
    ISO timestamp the quote was declined
[TYP] acceptedSignature: string
    captured acceptance signature data
[TYP] acceptedName: string
    name of who accepted the quote
[TYP] quantity: number
    a line-item quantity
[TYP] unit: string
    a line-item unit label
[TYP] price: number
    per-unit price in integer cents
[TYP] effectiveDate: string
    contract effective date
[TYP] startDate: string
    contract start date
[TYP] estimatedCompletionDate: string
    estimated completion date
[TYP] totalAmount: number
    contract total in integer cents
[TYP] signedAt: string
    ISO timestamp the contract was signed
[TYP] stepId: string
    wizard step identifier
[TYP] label: string
    a human-readable label
[TYP] value: string
    a resolved agreed value
[TYP] mood: string
    derived contract mood badge
[TYP] dueDate: string
    invoice due date
[TYP] amount: number
    a money amount in integer cents
[TYP] discountCents: number
    cumulative discount applied in integer cents
[TYP] discountReason: string
    reason for an applied discount
[TYP] issuedDate: string
    invoice issued date
[TYP] paidAt: string
    ISO timestamp the invoice was paid
[TYP] scheduledFor: string
    scheduled-fire date for scheduled invoices
[TYP:int] installmentIndex: number
    milestone position for invoice-X-of-Y framing
[TYP:int] installmentTotal: number
    total number of milestone invoices
[TYP] remindersMuted: boolean
    per-invoice mute for the reminder cadence
[TYP] channel: string
    a dispatch channel name
[TYP:int] day: number
    cadence step in days past due
[TYP] method: string
    a payment method label
[TYP] reference: string
    a free-text payment reference
[TYP] claimedAt: string
    ISO timestamp the customer claimed payment
[TYP] claimedBy: string
    name of who claimed payment
[TYP] urgency: string
    derived invoice urgency badge
[TYP] note: string
    a freeform note
[TYP] deltaAmountCents: number
    signed delta to the invoice total in integer cents
[TYP] originalAmountCents: number
    snapshot of the invoice amount at create time
[TYP] decidedAt: string
    ISO timestamp the change order was decided
[TYP] paperworkType: string
    paperwork kind: quote, contract, or invoice
[TYP] paperworkId: string
    id of the viewed paperwork record
[TYP] viewedAt: string
    ISO timestamp of the view
[TYP] viewerId: string
    identifier of the viewer
[TYP] viewerEmail: string
    email of the viewer
[TYP] userAgent: string
    raw user-agent of the viewer
[TYP] ipAddress: string
    viewer ip address
[TYP] referrer: string
    referrer url of the view
[TYP:int] durationMs: number
    view duration in milliseconds
[TYP] code: string
    a shortlink code
[TYP] kind: string
    a resource kind discriminator
[TYP] question: string
    a customer question on a quote
[TYP] contactBack: string
    how the contractor should follow up
[TYP] signature: string
    captured signature data
[TYP] tin: string
    a taxpayer identification number
[TYP] bytes: Uint8Array
    raw image bytes
[TYP] businessName: string
    the contractor's business name
[TYP] commsLanguage: string
    the outgoing-comms language code
[TYP] currentAmount: number
    the pre-change invoice total in integer cents
[TYP] newAmount: number
    the post-change invoice total in integer cents
[TYP] handle: string
    a payment-method handle or instructions
[TYP] addressLine: string
    single-line composed business address
[TYP] state: string
    two-letter state code
[TYP] hasLogo: boolean
    whether the contractor uploaded a logo
[TYP] customerSignedName: string
    the customer's typed legal name on signing
[TYP] entityType: string
    domain-event entity type
[TYP] entityId: string
    domain-event entity id
[TYP] action: string
    domain-event action verb
[TYP] alreadyAccepted: boolean
    whether the quote was already accepted
[TYP] alreadyDeclined: boolean
    whether the quote was already declined
[TYP] alreadySigned: boolean
    whether the contract was already signed
[TYP] lineItem: LineItemDto
    a nested quote line item
[TYP] term: ContractTermDto
    a nested captured contract term
[TYP] reminderHistory: ReminderHistoryEntryDto
    a nested reminder-cadence history row
[TYP] paymentIntent: PaymentIntentDto
    a nested customer payment claim
[TYP] contract: ContractDto
    a nested contract record
[TYP] invoice: InvoiceDto
    a nested invoice record
[TYP] contractor: ContractorDto
    a nested public contractor projection
[TYP] customer: CustomerPublicDto
    a nested public customer projection
[TYP] jobDetails: JobDetailsDto
    a nested job-details projection
[TYP] sibling: InvoiceSiblingDto
    a nested sibling invoice projection
[TYP] acceptedMethod: AcceptedMethodDto
    a nested accepted-payment method

[DTO] LineItemDto: description, quantity, unit, price
