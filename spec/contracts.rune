[TYP:uuid] id: string
    a unique record identifier
[TYP:ext] userId: string
    the authenticated owner id, minted from the session
[TYP] createdAt: string
    an ISO creation timestamp
[TYP] updatedAt: string
    an ISO last-updated timestamp
[TYP] ok: boolean
    a success flag
[TYP] quoteId: string
    a reference to a quote
[TYP] customerId: string
    a reference to a CRM customer
[TYP] contractId: string
    a reference to a contract
[TYP] status: string
    a lifecycle status string
[TYP] effectiveDate: string
    contract effective date
[TYP] startDate: string
    contract start date
[TYP] estimatedCompletionDate: string
    estimated completion date
[TYP] totalAmount: number
    contract total in integer cents
[TYP] signedAt: string
    ISO timestamp the contract was signed
[TYP] stepId: string
    wizard step identifier
[TYP] label: string
    a human-readable label
[TYP] value: string
    a resolved agreed value
[TYP] mood: string
    derived contract mood badge
[TYP] reason: string
    a machine-readable reason code
[TYP] to: string
    the dispatch recipient address
[TYP] from: string
    the dispatch sender address
[TYP] subject: string
    the email subject line
[TYP] sid: string
    a Twilio message SID
[TYP] code: string
    a shortlink code
[TYP] kind: string
    a resource kind discriminator
[TYP] pdf: Uint8Array
    rendered PDF bytes
[TYP] term: ContractTermDto
    a nested captured contract term
[TYP] contract: ContractDto
    a nested contract record

[DTO] ContractTermDto: stepId, label, value
    a captured contract wizard answer
[DTO] CreateContractDto: quoteId, customerId?, status?, effectiveDate?, startDate?, estimatedCompletionDate?, totalAmount?, signedAt?, term(s)
    input to create a contract
[DTO] UpdateContractDto: quoteId?, customerId?, status?, effectiveDate?, startDate?, estimatedCompletionDate?, totalAmount?, signedAt?, term(s)
    a partial contract patch
[DTO] ContractDto: id, userId, quoteId, customerId?, status?, effectiveDate?, startDate?, estimatedCompletionDate?, totalAmount?, signedAt?, term(s), mood?, createdAt, updatedAt
    a persisted contract record
[DTO] ContractListDto: contract(s)
    a list of contracts owned by the user
[DTO] OwnerDto: userId
    the owning user id wrapper
[DTO] GetByIdDto: id
    an id lookup wrapper
[DTO] OkDto: ok
    a success body for deletes
[DTO] EmailDispatchDto: id, to?, from?
    input to email a contract document
[DTO] SmsDispatchDto: id, to?
    input to text a contract document
[DTO] EmailMessageDto: to, subject
    an outbound email envelope
[DTO] SmsMessageDto: to
    an outbound SMS envelope
[DTO] SendEmailResultDto: ok, reason?, to, subject
    result of an email dispatch
[DTO] SendSmsResultDto: ok, to, sid?, reason?
    result of an SMS dispatch
[DTO] ShortlinkMintDto: userId, kind, id
    input to mint or reuse a shortlink
[DTO] ShortlinkDto: code, kind, id
    a persisted shortlink record
[DTO] RenderContractPdfDto: contractId, quoteId?
    input to render a contract PDF
[DTO] PdfDto: pdf
    rendered PDF bytes wrapper

