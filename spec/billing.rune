[TYP:uuid] id: string
    a unique record identifier
[TYP:ext] userId: string
    the authenticated owner id, minted from the session
[TYP] createdAt: string
    an ISO creation timestamp
[TYP] updatedAt: string
    an ISO last-updated timestamp
[TYP:nonempty] name: string
    a display or template name
[TYP] ok: boolean
    a success flag
[TYP:int] count: number
    a count of affected records
[TYP] status: string
    a lifecycle status string
[TYP] reason: string
    a machine-readable reason code
[TYP] customerId: string
    a reference to a CRM customer
[TYP] contractId: string
    a reference to a contract
[TYP] invoiceId: string
    a reference to an invoice
[TYP] jobName: string
    a short job title
[TYP] description: string
    freeform description text
[TYP] dueDate: string
    invoice due date
[TYP] amount: number
    a money amount in integer cents
[TYP] discountCents: number
    cumulative discount applied in integer cents
[TYP] discountReason: string
    reason for an applied discount
[TYP] issuedDate: string
    invoice issued date
[TYP] paidAt: string
    ISO timestamp the invoice was paid
[TYP] scheduledFor: string
    scheduled-fire date for scheduled invoices
[TYP:int] installmentIndex: number
    milestone position for invoice-X-of-Y framing
[TYP:int] installmentTotal: number
    total number of milestone invoices
[TYP] remindersMuted: boolean
    per-invoice mute for the reminder cadence
[TYP] channel: string
    a dispatch channel name
[TYP:int] day: number
    cadence step in days past due
[TYP] method: string
    a payment method label
[TYP] reference: string
    a free-text payment reference
[TYP] claimedAt: string
    ISO timestamp the customer claimed payment
[TYP] claimedBy: string
    name of who claimed payment
[TYP] urgency: string
    derived invoice urgency badge
[TYP] receivedAt: string
    ISO timestamp the payment was received
[TYP] confirmedAt: string
    ISO timestamp the contractor confirmed receipt
[TYP] percent: number
    installment percent of the total
[TYP] note: string
    a freeform note
[TYP] deltaAmountCents: number
    signed delta to the invoice total in integer cents
[TYP] originalAmountCents: number
    snapshot of the invoice amount at create time
[TYP] decidedAt: string
    ISO timestamp the change order was decided
[TYP] total: number
    a total amount or count
[TYP] totalPercent: number
    sum of installment percents
[TYP] isBalanced: boolean
    whether installments sum to 100 percent
[TYP] to: string
    the dispatch recipient address
[TYP] from: string
    the dispatch sender address
[TYP] subject: string
    the email subject line
[TYP] sid: string
    a Twilio message SID
[TYP:int] year: number
    a calendar year for the CSV export
[TYP] transcript: string
    a free-form voice transcript
[TYP] payerHint: string
    a parsed payer-name hint
[TYP] csv: string
    a CSV document body
[TYP] pdf: Uint8Array
    rendered PDF bytes
[TYP] paidTotal: number
    sum of payments in integer cents
[TYP] balance: number
    outstanding balance in integer cents
[TYP] expectedLandDate: string
    ISO date funds are expected to land
[TYP] thisWeekCents: number
    total expected this week in integer cents
[TYP] nextWeekCents: number
    total expected next week in integer cents
[TYP] atRiskCents: number
    total at-risk overdue amount in integer cents
[TYP] asOf: string
    reference timestamp for the forecast
[TYP] source: string
    where a forecast estimate came from
[TYP] escalated: boolean
    whether the day-30 escalation was used
[TYP] customerName: string
    a customer display name for copy
[TYP] matchedInvoiceId: string
    the single invoice matched from an utterance
[TYP] paymentId: string
    the minted payment id
[TYP] entityType: string
    domain-event entity type
[TYP] entityId: string
    domain-event entity id
[TYP] action: string
    domain-event action verb
[TYP] code: string
    a shortlink code
[TYP] kind: string
    a resource kind discriminator
[TYP] label: string
    a human-readable label
[TYP] sentAt: string
    ISO timestamp a reminder step was sent
[TYP] reminderHistory: ReminderHistoryEntryDto
    a nested reminder-cadence history row
[TYP] paymentIntent: PaymentIntentDto
    a nested customer payment claim
[TYP] installment: InstallmentDto
    a nested installment schedule row
[TYP] invoice: InvoiceDto
    a nested invoice record
[TYP] payment: PaymentDto
    a nested payment record
[TYP] changeOrder: ChangeOrderDto
    a nested change-order record
[TYP] plan: PaymentTermsDto
    a nested payment-terms template
[TYP] result: ReminderResultDto
    a nested reminder sweep result
[TYP] nudge: NudgeResultDto
    a nested nudge result
[TYP] entry: ForecastEntryDto
    a nested forecast entry
[TYP] disambiguation: DisambiguationDto
    a nested payment-match candidate
[TYP] parsed: ParsedUtteranceDto
    the parsed utterance fields

[DTO] ReminderHistoryEntryDto: day, sentAt, channel(s)
    one reminder-cadence history row
[DTO] PaymentIntentDto: method, amount, reference?, claimedAt, claimedBy?
    a customer's recorded payment claim
[DTO] InstallmentDto: percent, dueDate, label?, note?
    one installment in a payment schedule
[DTO] CreateInvoiceDto: contractId?, jobName?, description?, dueDate, customerId?, amount?, discountCents?, discountReason?, issuedDate?, status?, paidAt?, scheduledFor?, installmentIndex?, installmentTotal?, remindersMuted?, reminderHistory(s), paymentIntent?
    input to create an invoice
