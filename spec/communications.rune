[MOD] communications

[REQ] text.send(SendTextDto): TextMessageDto
    // REQ-904: acts on the signed-in user's line: the env line
    // (COMMS_TWILIO_*) when the user is COMMS_ENV_LINE_OWNER, else their
    // active bought line, else 409 no_line
    [NEW] lineResolver
    lineResolver.forUser(OwnerDto): LineContextDto
      no-line
    db:thread.upsert(PeerDto): ThreadDto
    ex:twilio.sendMessage(TwilioSendMessageDto): TwilioMessageResultDto
      unauthorized
      rejected
      timeout
    // sent from the resolved line's account and number
    db:textMessage.save(CreateTextMessageDto): TextMessageDto
    mq:events.emit(DomainEventDto): void
    [NEW] textMessage
    textMessage.toDto(): TextMessageDto


[REQ:open] text.receive(TwilioInboundMessageDto): TwimlDto
    // REQ-904: resolve the line from the form's AccountSid: main account
    // -> env line; known subaccount -> that line (its auth token unsealed);
    // unknown or missing -> 403. The signature is then checked with THAT
    // line's auth token.
    [NEW] lineResolver
    lineResolver.forAccount(AccountRefDto): LineContextDto
      forbidden
    [NEW] twilioSignature
    twilioSignature.verify(TwilioSignedRequestDto): SignatureDecisionDto
      forbidden
    db:thread.upsert(PeerDto): ThreadDto
    db:textMessage.save(CreateTextMessageDto): TextMessageDto
    mq:events.emit(DomainEventDto): void
    [NEW] twiml
    twiml.empty(): TwimlDto


[REQ:open] text.status(TwilioMessageStatusDto): OkDto
    // REQ-904: line from AccountSid (else 403); verify with its token
    [NEW] lineResolver
    lineResolver.forAccount(AccountRefDto): LineContextDto
      forbidden
    [NEW] twilioSignature
    twilioSignature.verify(TwilioSignedRequestDto): SignatureDecisionDto
      forbidden
    db:textMessage.patchStatus(MessageStatusPatchDto): TextMessageDto
      not-found
    [NEW] ok
    ok.toDto(): OkDto


[REQ] thread.all({}): ThreadListDto
    // REQ-904: on the user's line (env owner / active bought), else 409
    [NEW] lineResolver
    lineResolver.forUser(OwnerDto): LineContextDto
      no-line
    db:thread.list(OwnerDto): ThreadListDto


[REQ] thread.get(PeerQueryDto): ThreadDetailDto
    // REQ-904: on the user's line (env owner / active bought), else 409
    [NEW] lineResolver
