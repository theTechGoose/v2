    db:textMessage.listByPeer(PeerDto): TextMessageListDto
    db:call.listByPeer(PeerDto): CallListDto
    db:thread.markRead(PeerDto): ThreadDto
    [NEW] threadDetail
    threadDetail.toDto(): ThreadDetailDto


