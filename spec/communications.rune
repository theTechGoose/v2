[REQ] number.available(NumberSearchDto): AvailableNumberListDto
    // REQ-903: session required; 502 when Twilio fails
    [NEW] numberSearch
    numberSearch.validate(NumberSearchDto): TwilioNumberQueryDto
      missing-criteria
      bad-area-code
    // AvailablePhoneNumbers/US/Local: VoiceEnabled, SmsEnabled, PageSize
    ex:twilio.listAvailableNumbers(TwilioNumberQueryDto): TwilioNumberPageDto
      rejected
      timeout
    numberSearch.toDto(TwilioNumberPageDto): AvailableNumberListDto


[REQ] number.buy(BuyNumberDto): PublicLineDto
    // REQ-903: session required; at most one active line per user
    db:line.assertNoneActive(OwnerDto): OkDto
      line-exists
    // FriendlyName "documonster:<userId>"
    ex:twilio.createSubaccount(SubaccountRequestDto): SubaccountDto
      rejected
      timeout
    // any failure from here on: close the subaccount (Status=closed), 502
    ex:twilio.createApiKey(SubaccountRefDto): ApiKeyDto
      rejected
      timeout
    // VoiceUrl = /communications/twilio/voice/outgoing
    ex:twilio.createTwimlApp(TwimlAppRequestDto): TwimlAppDto
      rejected
      timeout
    // VoiceUrl /twilio/voice/incoming, SmsUrl /twilio/sms,
    // StatusCallback /twilio/voice/status
    ex:twilio.buyNumber(BuyNumberRequestDto): IncomingNumberDto
      rejected
      timeout
    // auth token + API key secret sealed with secret-box (REQ-212)
    [NEW] secretBox
    secretBox.seal(SecretPairDto): SealedSecretsDto
    db:line.save(CreateLineDto): LineDto
    [NEW] lineView
    lineView.redact(LineDto): PublicLineDto


[REQ] line.get({}): LineResultDto
    // REQ-903: the user's latest line, whatever its status; else line null
    db:line.latestFor(OwnerDto): LineLookupDto
    [NEW] lineView
    lineView.toResult(LineLookupDto): LineResultDto


[REQ] line.release({}): LineResultDto
    // REQ-905: idempotent; threads and calls stay readable
    db:line.latestFor(OwnerDto): LineLookupDto
    [NEW] lineView
    [PLY] lineView.release(LineLookupDto): LineResultDto
        [CSE] none
        lineView.toResult(LineLookupDto): LineResultDto
        [CSE] released
        // already released: returned untouched, no Twilio calls
        lineView.toResult(LineLookupDto): LineResultDto
        [CSE] active
        ex:twilio.releaseNumber(NumberRefDto): OkDto
          rejected
          timeout
        ex:twilio.closeSubaccount(SubaccountRefDto): OkDto
          rejected
          timeout
        db:line.markReleased(LineReleasePatchDto): LineDto
        lineView.fromLine(LineDto): LineResultDto


